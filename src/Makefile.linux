
PROJECT_NAME = game
CC = gcc
BIN_DIR = ../bin
LIB_DIR = ../lib/linux/raylib-5.5_linux_amd64
BIN = $(BIN_DIR)/$(PROJECT_NAME)

SRCS = main.c \
       level.c \
       player.c \
       bot.c \
       projectile.c \
       asset.c \
       pile.c \
	   cryptage.c \
	   sauvegarde.c \
	   menu.c \
	   log.c \
       updategame.c \
       dessin.c \
       option.c \
	   reseau.c \
	   multijoueur.c 
		arme.c \

OBJS = $(SRCS:.c=.o)


CFLAGS  = -Wall -Wextra -std=c99 -Wno-missing-braces
CFLAGS += -I$(LIB_DIR)/include
CFLAGS += -I../lib/headers
CFLAGS += -O2 -g

LDFLAGS  = -L$(LIB_DIR)/lib
LDFLAGS += -Wl,-rpath,'$$ORIGIN/../lib/linux/raylib-5.5_linux_amd64/lib'
LDFLAGS += -lraylib -lGL -lm -lpthread -ldl -lrt -lX11


all: $(BIN)

$(BIN): $(OBJS)
	mkdir -p $(BIN_DIR)
	$(CC) $(OBJS) -o $@ $(LDFLAGS)
	rm -f $(OBJS)   # supprime les fichiers .o juste après la compilation

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

run: all
	$(BIN)

clean:
	rm -f $(BIN)

info:
	@echo "Platform : Linux"
	@echo "Raylib   : local ($(LIB_DIR))"
	@echo "Binary   : $(BIN)"