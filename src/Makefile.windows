PROJECT_NAME = game
CC           = gcc
BIN_DIR      = ..\bin
LIB_DIR      = ..\lib\windows\raylib
BIN          = $(BIN_DIR)\$(PROJECT_NAME).exe

SRCS = main.c        \
       level.c       \
       player.c      \
       bot.c         \
       boss.c        \
       projectile.c  \
       asset.c       \
       pile.c        \
       cryptage.c    \
       sauvegarde.c  \
       menu.c        \
       log.c         \
       updategame.c  \
       dessin.c      \
       endGame.c     \
       option.c      \
       reseau.c      \
       multijoueur.c \
       arme.c        \
       audio.c       \
       heal.c

OBJS = $(SRCS:.c=.o)

# --- Flags de base ---
CFLAGS  = -Wall -Wextra -std=c99 -Wno-missing-braces
CFLAGS += -I$(LIB_DIR)\include
CFLAGS += -I..\lib\headers
CFLAGS += -O2 -g

LDFLAGS  = -L$(LIB_DIR)\lib
LDFLAGS += -lraylib -lopengl32 -lgdi32 -lwinmm -lws2_32

# --- Cibles principales ---
all: $(BIN)

$(BIN): $(OBJS)
	if not exist "$(BIN_DIR)" mkdir "$(BIN_DIR)"
	$(CC) $(OBJS) -o $@ $(LDFLAGS)

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

run: all
	$(BIN)

# --- Nettoyage ---
clean:
	del /Q *.o 2>nul || true

fclean: clean
	if exist "$(BIN)" del /Q "$(BIN)"

re: fclean all

# --- Modes de compilation ---
debug: CFLAGS += -g3 -O0 -DDEBUG
debug: re

release: CFLAGS += -O3 -DNDEBUG
release: fclean all

# --- Infos ---
info:
	@echo Platform  : Windows
	@echo Raylib    : local ($(LIB_DIR))
	@echo Binary    : $(BIN)
	@echo Sources   : $(words $(SRCS)) fichiers
	@echo CFLAGS    : $(CFLAGS)
	@echo LDFLAGS   : $(LDFLAGS)

.PHONY: all run clean fclean re debug release info